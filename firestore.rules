rules_version = '2';

// =============================================================================
//  Academia — Firestore Security Rules
//  Phase 7B — version-controlled, NOT YET DEPLOYED.
//
//  Scope (9 collections):
//    users · departments · majors · courses · curriculumCourses
//    semesters · courseOfferings · enrollments · supportRequests
//
//  Replaces the open test ruleset (`allow read, write: if request.time <
//  timestamp.date(2026, 8, 30)`) which grants unauthenticated read+write to
//  every document and expires on 2026-08-30.
//
//  MODEL (Phase 7):
//    courses         = permanent catalog subjects. NO semester, NO instructor.
//    courseOfferings = one course × one semester × one section.
//    enrollments     = one student attempt in one offering.
//    curriculumCourses = one row of a major's study plan (a course OR an
//                        unfilled requirement slot).
//
//  Phase 6E normalised every live user document, so the transitional
//  fail-open defaults for missing `role` / `status` are GONE: both fields are
//  now required and must hold an explicit valid value.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    //  Identity, role and account-status helpers
    // -------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Phase 6E backfilled role and status on every live user document, so a
    // missing or unknown value is now a malformed document, not a legacy one.
    // Both checks fail CLOSED.
    /*
     * Phase 8A: 'teacher' becomes a recognised account role.
     *
     * Without this line a teacher document fails every isActiveUser() gate
     * and the account can read nothing at all — not a permission gap, a
     * total lockout. Recognising the role grants only what isActiveUser
     * already grants any signed-in account: reads of the shared academic
     * catalogue. Every write path below remains admin-only.
     *
     * An unknown role (missing, empty, or anything else) still matches
     * nothing here and therefore has no access whatsoever.
     */
    function hasValidAccount() {
      return userDocExists()
        && userData().role in ['student', 'admin', 'teacher']
        && userData().status == 'active';
    }

    function isActiveUser() {
      return hasValidAccount();
    }

    function isActiveAdmin() {
      return hasValidAccount() && userData().role == 'admin';
    }

    /*
     * Declared in Phase 8A; first referenced in Phase 8.1.
     *
     * A teacher's capabilities are always SCOPED BY OWNERSHIP — never
     * granted by the role alone. Every rule that uses this helper also
     * checks that courseOfferings/{id}.teacherId == request.auth.uid.
     * The role says "may own offerings"; it never says "may read
     * everything".
     */
    function isActiveTeacher() {
      return hasValidAccount() && userData().role == 'teacher';
    }

    /*
     * The teacher assigned to an offering, or '' when the offering carries
     * no assignment.
     *
     * Offerings created before Phase 8.1 have no teacherId and can never
     * gain an owner implicitly: '' never equals a real uid, so an
     * unassigned offering grants nothing to anybody. instructorName is NOT
     * consulted — it is free text, and matching a name against an account
     * would turn a spelling coincidence into a permission.
     */
    function offeringTeacherId(offeringId) {
      return get(/databases/$(database)/documents/courseOfferings/$(offeringId))
        .data.get('teacherId', '');
    }

    function teacherOwnsOffering(offeringId) {
      return isActiveTeacher()
        && offeringId is string
        && offeringId != ''
        && exists(/databases/$(database)/documents/courseOfferings/$(offeringId))
        && offeringTeacherId(offeringId) == request.auth.uid;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // A field is either absent or explicitly null.
    function isAbsent(data, field) {
      return !(field in data) || data[field] == null;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    // ===================================================================
    //  users/{userId}        document ID IS the Firebase Auth UID
    // ===================================================================
    match /users/{userId} {

      // Fields a student may change about themselves.
      // NOTE: role, status, email, studentId, majorId and createdAt are absent
      // by design — majorId assigns an academic programme and is an
      // administrative decision, not a self-service one.
      function studentSelfEditable() {
        return [
          'fullName', 'major', 'academicLevel', 'photoUrl',
          'onboardingCompleted', 'onboardingStatus',
          'notificationPreferences', 'studyDays',
          'preferredSessionDuration', 'quietHours',
          'emailVerified', 'updatedAt'
        ];
      }

      // Admins may additionally administer the account and assign the
      // academic programme the study plan is built from.
      // POLICY: 'role' is deliberately absent — NO client may change a role,
      // including an admin. Role changes are out-of-band (Console/Admin SDK).
      function adminEditable() {
        return studentSelfEditable().concat(['status', 'studentId', 'majorId']);
      }

      // The Firestore mirror of emailVerified may only be written to the value
      // actually present in the Firebase Auth token. Prevents forgery and
      // prevents the FS/Auth drift found in the Phase 3 audit from recurring.
      function emailVerifiedMatchesToken() {
        return !('emailVerified' in changedKeys())
          || request.resource.data.emailVerified == request.auth.token.email_verified;
      }

      /*
       * Phase 8.1: an active teacher may `get` a STUDENT document.
       *
       * A roster that shows opaque uids instead of names is not a roster.
       * Enrollments store only userId, so the name must come from the user
       * document — there is no third place to read it from.
       *
       * Scope of the grant, and why it stops where it does:
       *   - `get` only, never `list` (see below): a teacher can resolve a
       *     uid they already hold, but can never enumerate the student body.
       *   - students only: admin and teacher documents stay unreadable, so
       *     this cannot be used to map out staff accounts.
       *
       * Narrowing it further to "students enrolled in an offering I teach"
       * is not expressible for a single-document get — the request carries
       * no offering to check ownership against. The alternative is
       * denormalising studentName onto every enrollment, which needs a
       * migration and duplicates a field that changes.
       */
      allow get: if isOwner(userId)
        || isActiveAdmin()
        || ( isActiveTeacher() && resource.data.role == 'student' );

      // Admin-only. Supports  users.where('role', '==', 'student')
      // and users.where('role', '==', 'teacher').
      // POLICY: students cannot read other students' profiles, and teachers
      // cannot enumerate users at all — a list query is how you would turn
      // the get() above into a directory dump.
      allow list: if isActiveAdmin();

      // Self-registration only. role and status are FORCED by the rule, so a
      // client can never register itself as an admin.
      // Email is compared case-insensitively: Firebase Auth lowercases token
      // emails while createStudentProfile() writes email.trim().
      allow create: if isOwner(userId)
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'active'
        && request.resource.data.emailVerified == false
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.keys().hasAll(
             ['fullName', 'email', 'role', 'status', 'emailVerified']);

      allow update: if
        // ---- student editing their own profile / preferences ----
        ( isOwner(userId)
          && isActiveUser()
          && changedKeys().hasOnly(studentSelfEditable())
          && emailVerifiedMatchesToken()
        )
        ||
        // ---- active admin administering an account ----
        ( isActiveAdmin()
          && changedKeys().hasOnly(adminEditable())
          && request.resource.data.status in ['active', 'disabled']
          && request.resource.data.role == resource.data.role
        );

      allow delete: if false;
    }

    // ===================================================================
    //  departments/{departmentId}
    //  Organisational unit that owns courses and to which majors belong.
    // ===================================================================
    match /departments/{departmentId} {

      function validDepartment() {
        return isNonEmptyString(request.resource.data.name)
          && request.resource.data.status in ['active', 'archived']
          && request.resource.data.get('source', 'manual') in ['manual', 'api'];
      }

      // Students browse the catalogue, so the whole academic structure is
      // readable by any active account. None of it is personal data.
      allow read: if isActiveUser();

      allow create: if isActiveAdmin()
        && validDepartment()
        && request.resource.data.keys().hasAll(['name', 'status']);

      allow update: if isActiveAdmin() && validDepartment();

      // Archive over delete: a deleted department orphans its courses
      // and majors, which nothing in the app can repair.
      allow delete: if false;
    }

    // ===================================================================
    //  majors/{majorId}       a degree programme; owns a curriculum
    // ===================================================================
    match /majors/{majorId} {

      function validMajor() {
        return isNonEmptyString(request.resource.data.name)
          && isNonEmptyString(request.resource.data.code)
          && isNonEmptyString(request.resource.data.departmentId)
          && exists(/databases/$(database)/documents/departments/$(request.resource.data.departmentId))
          && request.resource.data.totalLevels is int
          && request.resource.data.totalLevels > 0
          && request.resource.data.status in ['active', 'archived']
          && request.resource.data.get('source', 'manual') in ['manual', 'api'];
      }

      allow read: if isActiveUser();

      allow create: if isActiveAdmin()
        && validMajor()
        && request.resource.data.keys().hasAll(
             ['name', 'code', 'departmentId', 'totalLevels', 'status']);

      allow update: if isActiveAdmin() && validMajor();

      allow delete: if false;
    }

    // ===================================================================
    //  courses/{courseId}    PERMANENT CATALOG SUBJECT — auto-ID
    //
    //  A course is the academic subject itself. It has NO semester and NO
    //  instructor: those belong to a courseOffering. courseCode is a unique
    //  business field, enforced in CourseService — Firestore rules cannot
    //  express uniqueness because they cannot run queries.
    // ===================================================================
    match /courses/{courseId} {

      // The Phase 6C offering-shaped fields are actively rejected, not merely
      // "not required". Re-adding them would silently recreate the modelling
      // error that Phase 7 exists to undo.
      function hasNoOfferingFields() {
        return !('semesterId' in request.resource.data)
          && !('instructorName' in request.resource.data)
          && !('academicYear' in request.resource.data)
          && !('semester' in request.resource.data);
      }

      function validCourse() {
        return isNonEmptyString(request.resource.data.courseCode)
          && isNonEmptyString(request.resource.data.title)
          && request.resource.data.creditHours is int
          && request.resource.data.creditHours > 0
          && isNonEmptyString(request.resource.data.departmentId)
          && exists(/databases/$(database)/documents/departments/$(request.resource.data.departmentId))
          && request.resource.data.status in ['active', 'archived']
          && request.resource.data.get('source', 'manual') in ['manual', 'api']
          && hasNoOfferingFields();
      }

      // Catalog-style read. Keeping this unconditional (for active users) is a
      // deliberate trade-off: per-document exists() checks would exceed the
      // per-query document-access budget. Catalog data is not personal data.
      allow read: if isActiveUser();

      allow create: if isActiveAdmin()
        && validCourse()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasAll(
             ['courseCode', 'title', 'departmentId',
              'creditHours', 'status', 'createdBy']);

      // createdBy is immutable — it records who introduced the subject, and
      // one live course still points at the disabled tombstone admin.
      allow update: if isActiveAdmin()
        && validCourse()
        && request.resource.data.createdBy == resource.data.createdBy;

      // POLICY (approved Phase 5B, unchanged): archive-first. Removal is
      // `status: 'archived'` via CourseService.archiveCourse(). A hard delete
      // would orphan every offering and enrollment that references the course.
      allow delete: if false;
    }

    // ===================================================================
    //  courseOfferings/{offeringId}   ID: {courseId}_{semesterId}_{section}
    //
    //  One course taught in one semester, one section. Carries the semester
    //  and the instructor — the two things a permanent course must not.
    // ===================================================================
    match /courseOfferings/{offeringId} {

      function d() {
        return request.resource.data;
      }

      // The document ID must encode the exact relationship it stores. This is
      // what makes a duplicate offering structurally impossible and what makes
      // "copy last semester's offerings" safe to re-run.
      //
      // NOTE: the ID is built from stored fields, never parsed back out —
      // semesterId itself contains underscores (semester_2026_1).
      function offeringIdMatches() {
        return offeringId == d().courseId + '_' + d().semesterId + '_' + d().section;
      }

      function referencesExist() {
        return exists(/databases/$(database)/documents/courses/$(d().courseId))
          && exists(/databases/$(database)/documents/semesters/$(d().semesterId));
      }

      /*
       * teacherId is OPTIONAL, but never arbitrary.
       *
       * Absent = unassigned, which is the state every pre-8.1 offering is
       * in and a state the admin may deliberately keep. Present = it must
       * name a real account whose role is 'teacher'. Without the lookup an
       * admin could write any uid — including their own — and hand offering
       * ownership to an account that is not a teacher at all.
       *
       * The account's status is deliberately NOT checked here: assignment
       * must survive a teacher being temporarily disabled. Access is gated
       * on isActiveTeacher() at read time, so a disabled teacher owns the
       * offering on paper and can read nothing.
       */
      function validTeacherAssignment() {
        return isAbsent(d(), 'teacherId')
          || ( isNonEmptyString(d().teacherId)
               && exists(/databases/$(database)/documents/users/$(d().teacherId))
               && get(/databases/$(database)/documents/users/$(d().teacherId))
                    .data.role == 'teacher' );
      }

      function validOffering() {
        return isNonEmptyString(d().courseId)
          && isNonEmptyString(d().semesterId)
          && isNonEmptyString(d().instructorName)
          && isNonEmptyString(d().section)
          && validTeacherAssignment()
          && d().status in ['active', 'archived', 'cancelled']
          && d().get('source', 'manual') in ['manual', 'api'];
      }

      allow read: if isActiveUser();

      allow create: if isActiveAdmin()
        && validOffering()
        && offeringIdMatches()
        && referencesExist()
        && d().createdBy == request.auth.uid
        && d().keys().hasAll(
             ['courseId', 'semesterId', 'instructorName', 'section',
              'status', 'createdBy']);

      // courseId, semesterId and section form the document ID, so they are
      // immutable — changing one would desynchronise ID from content. To move
      // a course to another semester you create another offering.
      allow update: if isActiveAdmin()
        && validOffering()
        && d().courseId == resource.data.courseId
        && d().semesterId == resource.data.semesterId
        && d().section == resource.data.section
        && d().createdBy == resource.data.createdBy;

      // Archive (or cancel) over delete: enrollments point at offerings.
      allow delete: if false;
    }

    // ===================================================================
    //  curriculumCourses/{entryId}
    //    course row: {majorId}_{courseId}
    //    slot row:   {majorId}_slot_{academicLevel}_{sequence}
    //
    //  One row of a major's study plan. A row is either a specific course or
    //  an unfilled requirement slot ("متطلب جامعة اختياري (1)"). Slots are
    //  NOT courses: no document is ever created for them in `courses`.
    // ===================================================================
    match /curriculumCourses/{entryId} {

      function d() {
        return request.resource.data;
      }

      function validLevel() {
        return d().academicLevel is int
          && d().academicLevel >= 1
          && d().academicLevel <= 8;
      }

      function validRequirementType() {
        return d().requirementType in [
          'major_required', 'major_elective',
          'college_required', 'university_required',
          'university_elective', 'free_elective'
        ];
      }

      // Prerequisites are STORED but NOT ENFORCED anywhere in the MVP.
      // prerequisiteText holds the official wording verbatim and is kept even
      // when no course ID could be resolved with confidence.
      function validPrerequisites() {
        return (!('prerequisiteCourseIds' in d())
                 || d().prerequisiteCourseIds is list)
          && (isAbsent(d(), 'prerequisiteText')
               || d().prerequisiteText is string);
      }

      // A row is a course OR a slot, never both and never neither.
      function validCourseEntry() {
        return d().entryType == 'course'
          && isNonEmptyString(d().courseId)
          && exists(/databases/$(database)/documents/courses/$(d().courseId))
          && isAbsent(d(), 'slotLabel')
          && entryId == d().majorId + '_' + d().courseId;
      }

      function validSlotEntry() {
        return d().entryType == 'slot'
          && isAbsent(d(), 'courseId')
          && isNonEmptyString(d().slotLabel)
          && d().creditHours is int
          && d().creditHours > 0
          && entryId == d().majorId + '_slot_' + string(d().academicLevel)
                        + '_' + string(d().sequence);
      }

      function validEntry() {
        return isNonEmptyString(d().majorId)
          && exists(/databases/$(database)/documents/majors/$(d().majorId))
          && validLevel()
          && validRequirementType()
          && validPrerequisites()
          && d().sequence is int
          && d().sequence >= 0
          && ( validCourseEntry() || validSlotEntry() );
      }

      // Every student needs to read their own programme's plan.
      allow read: if isActiveUser();

      allow create: if isActiveAdmin()
        && validEntry()
        && d().keys().hasAll(
             ['majorId', 'entryType', 'academicLevel',
              'requirementType', 'sequence']);

      // majorId and the entry identity are part of the document ID, so a
      // valid update necessarily keeps them: validEntry() re-checks the ID.
      allow update: if isActiveAdmin()
        && validEntry()
        && d().majorId == resource.data.majorId
        && d().entryType == resource.data.entryType;

      // A plan row has no status field, so removing a requirement from a plan
      // is a real delete. Admin-only.
      allow delete: if isActiveAdmin();
    }

    // ===================================================================
    //  semesters/{semesterId}     ID: semester_{academicYear}_{number}
    // ===================================================================
    match /semesters/{semesterId} {

      function validSemester() {
        return request.resource.data.status in ['upcoming', 'current', 'completed']
          && request.resource.data.semesterNumber is int
          && request.resource.data.semesterNumber > 0
          && request.resource.data.academicYear is string
          && request.resource.data.semesterName is string;
      }

      // Every active user needs this to resolve the current semester.
      allow read: if isActiveUser();

      allow create: if isActiveAdmin()
        && validSemester()
        && request.resource.data.keys().hasAll(
             ['academicYear', 'semesterNumber', 'semesterName', 'status']);

      // academicYear and semesterNumber define the document ID, so they are
      // immutable — letting them drift would desynchronise ID from content.
      allow update: if isActiveAdmin()
        && validSemester()
        && request.resource.data.academicYear == resource.data.academicYear
        && request.resource.data.semesterNumber == resource.data.semesterNumber;

      allow delete: if isActiveAdmin();
    }

    // ===================================================================
    //  enrollments/{enrollmentId}        ID: {userId}_{offeringId}
    //
    //  One student attempt in one offering. Retaking a subject in a later
    //  semester is a different offering, therefore a different document —
    //  the earlier attempt is never overwritten.
    // ===================================================================
    match /enrollments/{enrollmentId} {

      function d() {
        return request.resource.data;
      }

      // The document ID must encode the exact relationship it stores. This is
      // what makes a duplicate enrollment structurally impossible.
      function enrollmentIdMatches() {
        return enrollmentId == d().userId + '_' + d().offeringId;
      }

      function targetIsStudent() {
        return exists(/databases/$(database)/documents/users/$(d().userId))
          && get(/databases/$(database)/documents/users/$(d().userId))
               .data.role == 'student';
      }

      function offeringData() {
        return get(/databases/$(database)/documents/courseOfferings/$(d().offeringId)).data;
      }

      // courseId and semesterId are denormalised from the offering so that
      // "current courses", "history" and "group by subject" are each a single
      // equality query. They must therefore agree with the offering exactly.
      function matchesOffering() {
        return exists(/databases/$(database)/documents/courseOfferings/$(d().offeringId))
          && d().courseId == offeringData().courseId
          && d().semesterId == offeringData().semesterId;
      }

      function validAttemptNumber() {
        return d().attemptNumber is int && d().attemptNumber >= 1;
      }

      function validCompletionStatus() {
        return isAbsent(d(), 'completionStatus')
          || d().completionStatus in ['passed', 'failed', 'incomplete'];
      }

      function validGrade() {
        return isAbsent(d(), 'grade') || d().grade is string;
      }

      /*
       * Student: own rows only.  Admin: everything.
       * Teacher: rows of offerings they own — their class roster.
       *
       * Compatible with where('userId','==',uid) and, for admins and
       * teachers, where('offeringId','==',id): rules are evaluated per
       * document, so a roster query over one offering succeeds while an
       * unfiltered teacher query fails on the first row it does not own.
       *
       * READ ONLY for teachers. Recording results stays admin-only — the
       * update rule below is the tightest in the ruleset and opening it
       * would mean an ownership get() inside the most sensitive collection
       * in exchange for a display-only field.
       */
      allow read: if ( isActiveUser() && resource.data.userId == request.auth.uid )
        || isActiveAdmin()
        || teacherOwnsOffering(resource.data.get('offeringId', ''));

      // POLICY: students can NEVER enrol themselves, and can never author an
      // academic outcome — completionStatus and grade must not exist yet.
      allow create: if isActiveAdmin()
        && enrollmentIdMatches()
        && isNonEmptyString(d().userId)
        && isNonEmptyString(d().offeringId)
        && d().status == 'active'
        && isAbsent(d(), 'completionStatus')
        && isAbsent(d(), 'grade')
        && validAttemptNumber()
        && d().assignedBy == request.auth.uid
        && d().keys().hasAll(
             ['userId', 'offeringId', 'courseId', 'semesterId',
              'attemptNumber', 'status', 'assignedBy'])
        && targetIsStudent()
        && matchesOffering();

      /*
       * The relationship is frozen after creation. userId, offeringId,
       * courseId, semesterId and attemptNumber can never change: they are what
       * the document IS. Only the outcome may move.
       *
       * Students are excluded entirely, which is what stops a student from
       * writing their own status, completionStatus or grade.
       */
      allow update: if isActiveAdmin()
        && d().userId == resource.data.userId
        && d().offeringId == resource.data.offeringId
        && d().courseId == resource.data.courseId
        && d().semesterId == resource.data.semesterId
        && d().attemptNumber == resource.data.attemptNumber
        && d().status in ['active', 'completed', 'removed']
        && validCompletionStatus()
        && validGrade()
        && changedKeys().hasOnly(
             ['status', 'completionStatus', 'grade', 'updatedAt']);

      // Kept admin-only for maintenance. Normal UI removal uses
      // status: 'removed' so the row survives as admin audit history.
      allow delete: if isActiveAdmin();
    }

    // ===================================================================
    //  courseFiles/{fileId}
    //
    //  Metadata for a file uploaded to a course OFFERING. The binary itself
    //  lives in Cloudinary; this document is what makes it queryable and
    //  what controls who may see it.
    //
    //  A file belongs to an offering, not to a permanent course: material
    //  taught this term is not automatically the material of another term.
    // ===================================================================
    match /courseFiles/{fileId} {

      function d() {
        return request.resource.data;
      }

      // Enrollment IDs are deterministic ({userId}_{offeringId}), so a
      // student's enrollment in an offering is a single document lookup —
      // no query needed, which is what makes this expressible in rules.
      function enrollmentPath(offeringId) {
        return /databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + offeringId);
      }

      // Active enrollment = currently studying it.
      // Completed enrollment = studied it before; historical material stays
      // readable, otherwise a student loses their own past course files.
      // Removed enrollment grants nothing.
      function isEnrolledInOffering(offeringId) {
        return isSignedIn()
          && exists(enrollmentPath(offeringId))
          && get(enrollmentPath(offeringId)).data.status in ['active', 'completed'];
      }

      function offeringData() {
        return get(/databases/$(database)/documents/courseOfferings/$(d().offeringId)).data;
      }

      // courseId and semesterId are denormalised from the offering, so they
      // must agree with it. Unverified copies drift from their source.
      function matchesOffering() {
        return exists(/databases/$(database)/documents/courseOfferings/$(d().offeringId))
          && d().courseId == offeringData().courseId
          && d().semesterId == offeringData().semesterId;
      }

      function validFile() {
        return isNonEmptyString(d().offeringId)
          && isNonEmptyString(d().title)
          && isNonEmptyString(d().cloudinaryUrl)
          && isNonEmptyString(d().cloudinaryPublicId)
          && d().category in ['lecture', 'summary', 'assignment_material',
                              'reference', 'other']
          && d().status in ['active', 'archived']
          && d().fileSize is int
          && d().fileSize > 0
          // Mirrors the 10 MB client-side limit; a client can lie about the
          // number, but the rule keeps an obviously wrong value out.
          && d().fileSize <= 10485760;
      }

      // Admins see everything; a student sees a file only for an offering
      // they are (or were) enrolled in.
      // Active teacher may read files only for their own offering.
      allow read: if isActiveAdmin()
        || ( isActiveUser() && isEnrolledInOffering(resource.data.offeringId) )
        || teacherOwnsOffering(resource.data.offeringId);

      // POLICY: students never upload course material. Files are course
      // content authored by staff, not student submissions.
      allow create: if ( isActiveAdmin() || teacherOwnsOffering(d().offeringId) )
        && validFile()
        && matchesOffering()
        && d().uploadedBy == request.auth.uid
        && d().keys().hasAll(
             ['offeringId', 'courseId', 'semesterId', 'title', 'category',
              'fileName', 'fileSize', 'cloudinaryUrl', 'cloudinaryPublicId',
              'cloudinaryResourceType', 'uploadedBy', 'status']);

      /*
       * Only the descriptive fields may change. The offering it belongs to,
       * the Cloudinary references and the uploader are frozen: changing any
       * of them would make the document describe a different file, which is
       * what a new upload is for.
       */
      allow update: if ( isActiveAdmin() || teacherOwnsOffering(resource.data.offeringId) )
        && d().offeringId == resource.data.offeringId
        && d().courseId == resource.data.courseId
        && d().semesterId == resource.data.semesterId
        && d().cloudinaryUrl == resource.data.cloudinaryUrl
        && d().cloudinaryPublicId == resource.data.cloudinaryPublicId
        && d().cloudinaryResourceType == resource.data.cloudinaryResourceType
        && d().uploadedBy == resource.data.uploadedBy
        && d().status in ['active', 'archived']
        && d().category in ['lecture', 'summary', 'assignment_material',
                            'reference', 'other']
        && isNonEmptyString(d().title)
        && changedKeys().hasOnly(
             ['title', 'description', 'category', 'status', 'updatedAt']);

      /*
       * Archive over delete, and here it is not merely a preference: the
       * upload preset is unsigned, so the client cannot delete the binary
       * from Cloudinary. Deleting the metadata would leave a file nothing
       * in the system knows about.
       */
      allow delete: if false;
    }

    // ===================================================================
    //  assignments/{assignmentId}
    //
    //  Academic assignments attached to a course offering, created by the
    //  assigned teacher.
    // ===================================================================
    match /assignments/{assignmentId} {

      function d() {
        return request.resource.data;
      }

      function enrollmentPath(offeringId) {
        return /databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + offeringId);
      }

      function isEnrolledInOffering(offeringId) {
        return isSignedIn()
          && exists(enrollmentPath(offeringId))
          && get(enrollmentPath(offeringId)).data.status in ['active', 'completed'];
      }

      function offeringData() {
        return get(/databases/$(database)/documents/courseOfferings/$(d().offeringId)).data;
      }

      function matchesOffering() {
        return exists(/databases/$(database)/documents/courseOfferings/$(d().offeringId))
          && d().courseId == offeringData().courseId
          && d().semesterId == offeringData().semesterId;
      }

      function validAssignment() {
        return isNonEmptyString(d().offeringId)
          && isNonEmptyString(d().courseId)
          && isNonEmptyString(d().semesterId)
          && isNonEmptyString(d().title)
          && d().description is string
          && d().priority in ['low', 'medium', 'high']
          && d().status in ['active', 'archived']
          && d().dueAt is timestamp;
      }

      /*
       * READ
       *   admin   — globally, for oversight.
       *   teacher — only assignments of an offering they own.
       *   student — only offerings they hold an enrollment in, with the
       *             SAME semantics as course files: 'active' or 'completed'
       *             grant access, 'removed' grants nothing. A student who
       *             studied the course last term keeps their material.
       *
       * Archived assignments are not hidden here: hiding is the query's
       * job (status == 'active'), and an admin must still be able to read
       * what they archived.
       */
      allow read: if isActiveAdmin()
        || ( isActiveUser() && isEnrolledInOffering(resource.data.offeringId) )
        || teacherOwnsOffering(resource.data.offeringId);

      /*
       * CREATE — the assigned teacher, and nobody else.
       *
       * Admin create is denied by omission and that is deliberate: the
       * admin owns academic STRUCTURE, the teacher owns academic CONTENT.
       * Students are denied for the obvious reason.
       *
       * matchesOffering() re-derives courseId/semesterId from the real
       * offering document, so a forged pair cannot be smuggled in through
       * the client; createdBy is pinned to the caller so authorship cannot
       * be attributed to someone else.
       */
      allow create: if teacherOwnsOffering(d().offeringId)
        && validAssignment()
        && matchesOffering()
        && d().createdBy == request.auth.uid
        && d().status == 'active'
        && d().keys().hasAll(
             ['offeringId', 'courseId', 'semesterId', 'title', 'description',
              'dueAt', 'priority', 'createdBy', 'status']);

      /*
       * UPDATE — two disjoint capabilities, never one relaxed rule.
       *
       * Teacher (authoring): may change what they wrote — title,
       * description, dueAt, priority — and may archive. Ownership is read
       * from resource.data.offeringId, the ORIGINAL document: trusting the
       * incoming offeringId would let a teacher move an assignment into
       * another teacher's offering by simply sending a different id.
       *
       * Admin (moderation): may set status to 'archived' and nothing else.
       * Every academic field is pinned to its existing value AND
       * changedKeys() is restricted, so the two checks fail independently.
       * Requiring status == 'archived' also means an admin cannot RESTORE
       * an archived assignment — moderation is one-directional by policy.
       */
      allow update: if (
            teacherOwnsOffering(resource.data.offeringId)
            && d().offeringId == resource.data.offeringId
            && d().courseId == resource.data.courseId
            && d().semesterId == resource.data.semesterId
            && d().createdBy == resource.data.createdBy
            && d().status in ['active', 'archived']
            && d().priority in ['low', 'medium', 'high']
            && isNonEmptyString(d().title)
            && d().dueAt is timestamp
            && changedKeys().hasOnly(['title', 'description', 'dueAt', 'priority', 'status', 'updatedAt'])
          ) || (
            isActiveAdmin()
            && d().offeringId == resource.data.offeringId
            && d().courseId == resource.data.courseId
            && d().semesterId == resource.data.semesterId
            && d().createdBy == resource.data.createdBy
            && d().title == resource.data.title
            && d().description == resource.data.description
            && d().dueAt == resource.data.dueAt
            && d().priority == resource.data.priority
            && d().status == 'archived'
            && changedKeys().hasOnly(['status', 'updatedAt'])
          );

      /*
       * Archive over delete, for everyone including admins. A hard delete
       * would silently remove work students may have organised around, and
       * nothing in the app can undo it.
       */
      allow delete: if false;
    }

    // ===================================================================
    //  supportRequests/{requestId}
    //  Outside the academic scope, but required: SupportService already
    //  writes here and default-deny would break the Help & FAQ form.
    //  Field names verified against SupportRequest.toFirestore(): uses `uid`.
    // ===================================================================
    match /supportRequests/{requestId} {

      allow create: if isActiveUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasAll(
             ['uid', 'subject', 'message', 'status']);

      // POLICY: admin-only inbox. A student writes a request and never reads
      // it back — not their own, and not anyone else's.
      allow read: if isActiveAdmin();

      /*
       * Phase 7H5: the admin inbox may move a request through its lifecycle
       * and nothing else.
       *
       * Previously any admin write was accepted as long as `uid` survived,
       * which allowed silently rewriting the subject or the message a student
       * had sent. What the student wrote is the record; only its handling
       * state belongs to the admin.
       */
      allow update: if isActiveAdmin()
        && request.resource.data.status in ['open', 'resolved']
        && changedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if false;
    }

    // ===================================================================
    //  studySessions/{sessionId}
    //  A student's own focus-study sessions. Strictly private.
    //
    //  Nobody but the owner: not another student, not a teacher, not an
    //  admin. A study session is a personal time-management record, not
    //  academic work — it carries no grade and no submission, so no role
    //  has an academic reason to read it. There is deliberately no
    //  isActiveAdmin() escape hatch here; if oversight is ever required it
    //  must be argued for and added explicitly, not inherited by default.
    // ===================================================================
    match /studySessions/{sessionId} {

      function isActiveStudent() {
        return hasValidAccount() && userData().role == 'student';
      }

      function d() {
        return request.resource.data;
      }

      function validSession() {
        return isNonEmptyString(d().userId)
          && d().plannedMinutes is int
          && d().plannedMinutes >= 5
          && d().plannedMinutes <= 180
          && d().actualMinutes is int
          && d().actualMinutes >= 0
          && d().status in ['active', 'completed', 'cancelled']
          && validCourseLink();
      }

      /*
       * The course link is optional, but never arbitrary.
       *
       * Absent = a general study session, which is a legitimate choice.
       * Present = both ids must be there AND the student must actually be
       * enrolled in that offering. Without the enrolment lookup a student
       * could attribute study time to a course they never took, which
       * would make the history quietly untrue.
       */
      function validCourseLink() {
        return (isAbsent(d(), 'offeringId') && isAbsent(d(), 'courseId'))
          || (isNonEmptyString(d().offeringId)
               && isNonEmptyString(d().courseId)
               && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + d().offeringId))
               && get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + d().offeringId)).data.userId == request.auth.uid);
      }

      allow read: if isActiveStudent() && isOwner(resource.data.userId);

      allow create: if isActiveStudent()
        && isOwner(d().userId)
        && validSession()
        && d().status == 'active'
        && d().actualMinutes == 0
        && d().keys().hasAll(
             ['userId', 'plannedMinutes', 'actualMinutes', 'status',
              'startedAt', 'createdAt', 'updatedAt']);

      /*
       * Update exists to close a session, not to rewrite it.
       *
       * The owner, the planned duration and the course link are all fixed
       * at creation: letting them change afterwards would allow a finished
       * session to be re-pointed at another course, or its plan inflated
       * after the fact.
       */
      allow update: if isActiveStudent()
        && isOwner(resource.data.userId)
        && d().userId == resource.data.userId
        && d().plannedMinutes == resource.data.plannedMinutes
        && d().get('offeringId', '') == resource.data.get('offeringId', '')
        && d().get('courseId', '') == resource.data.get('courseId', '')
        && d().status in ['completed', 'cancelled']
        && d().actualMinutes is int
        && d().actualMinutes >= 0
        && d().actualMinutes <= resource.data.plannedMinutes
        && changedKeys().hasOnly(
             ['status', 'actualMinutes', 'endedAt', 'updatedAt']);

      // The owner may remove their own record; nobody else can.
      allow delete: if isActiveStudent() && isOwner(resource.data.userId);
    }

    // ===================================================================
    //  tasks/{taskId}
    //  Personal tasks for students.
    // ===================================================================
    match /tasks/{taskId} {

      function isActiveStudent() {
        return hasValidAccount() && userData().role == 'student';
      }

      function validTask() {
        return isNonEmptyString(request.resource.data.userId)
          && isNonEmptyString(request.resource.data.title)
          && request.resource.data.priority in ['high', 'medium', 'low']
          && request.resource.data.status in ['pending', 'completed']
          && request.resource.data.type in ['assignment', 'lecture', 'study', 'exam']
          && validCourseLink();
      }

      function validCourseLink() {
        return (isAbsent(request.resource.data, 'enrollmentId')
                 && isAbsent(request.resource.data, 'offeringId')
                 && isAbsent(request.resource.data, 'courseId'))
          || (isNonEmptyString(request.resource.data.enrollmentId)
               && isNonEmptyString(request.resource.data.offeringId)
               && isNonEmptyString(request.resource.data.courseId)
               && exists(/databases/$(database)/documents/enrollments/$(request.resource.data.enrollmentId))
               && get(/databases/$(database)/documents/enrollments/$(request.resource.data.enrollmentId)).data.userId == request.auth.uid);
      }

      allow read, delete: if isActiveStudent() && isOwner(resource.data.userId);

      allow create: if isActiveStudent()
        && isOwner(request.resource.data.userId)
        && validTask()
        && request.resource.data.keys().hasAll(['userId', 'title', 'priority', 'status', 'type', 'createdAt', 'updatedAt']);

      allow update: if isActiveStudent()
        && isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId // userId immutable
        && validTask();
    }

    // ===================================================================
    //  assignmentProgress/{studentId}_{assignmentId}
    //
    //  A student's PRIVATE "I finished this" mark on an academic
    //  assignment. Not a submission: no file, no text, no grade, no
    //  teacher review, no notification.
    //
    //  WHY A SEPARATE COLLECTION AND NOT A FIELD ON /assignments
    //  An assignment document belongs to an offering and is shared by
    //  every student in it. A completion field there would be written by
    //  one student and read by all of them — marking it done for the
    //  whole section. Per-student state needs a per-student document.
    //
    //  VISIBILITY
    //  Owner only. Not the teacher, not an admin, not a classmate. This
    //  is personal organisation, and nothing in the product reads it on
    //  anyone else's behalf. If a future feature genuinely needs teacher
    //  visibility, that is a deliberate widening — not an oversight to
    //  be patched in quietly here.
    //
    //  The deterministic ID follows the enrollments precedent
    //  ({userId}_{offeringId}): it makes two conflicting progress rows
    //  for one pair structurally impossible, and it is validated on
    //  every write so the ID can never disagree with the fields.
    // ===================================================================
    match /assignmentProgress/{progressId} {

      function isActiveStudent() {
        return hasValidAccount() && userData().role == 'student';
      }

      function d() {
        return request.resource.data;
      }

      // The document ID must encode exactly the pair it stores.
      function idMatches() {
        return progressId == d().studentId + '_' + d().assignmentId;
      }

      /*
       * studentId is checked against the TOKEN, not merely against the
       * existing document: that is what stops a student from writing a
       * progress row on somebody else's behalf, and combined with
       * idMatches() it stops them from parking one at an arbitrary path.
       */
      function validProgress() {
        return isOwner(d().studentId)
          && isNonEmptyString(d().studentId)
          && isNonEmptyString(d().assignmentId)
          && d().isCompleted is bool
          && idMatches();
      }

      // Supports assignmentProgress.where('studentId', '==', uid).
      // Rules are evaluated per document, so that query succeeds while an
      // unfiltered one fails on the first row the caller does not own.
      allow read: if isActiveStudent() && isOwner(resource.data.studentId);

      allow create: if isActiveStudent()
        && validProgress()
        && d().keys().hasAll(
             ['studentId', 'assignmentId', 'isCompleted', 'updatedAt']);

      // The pair is frozen after creation; only the mark itself moves.
      allow update: if isActiveStudent()
        && isOwner(resource.data.studentId)
        && d().studentId == resource.data.studentId
        && d().assignmentId == resource.data.assignmentId
        && validProgress();

      // Undoing a mark writes isCompleted:false rather than deleting, to
      // match how tasks reopen. Delete stays available for the owner
      // alone so a student can always clear their own record.
      allow delete: if isActiveStudent() && isOwner(resource.data.studentId);
    }

    // ===================================================================
    //  Explicit default deny for every unmatched path.
    //  Firestore already denies by default; this documents the intent and
    //  covers any collection created before its rules are written.
    //  (This does not revoke grants from the more specific matches above.)
    // ===================================================================
    // ===================================================================
    //  المساحة المشتركة — منشورات وتعليقات وإعجابات وبلاغات
    //
    //  🔴 مصدر هذا القسم: النسخة المنشورة فعلًا في Firebase (ruleset
    //  5d22e88d) لا هذا الفرع. زميلٌ نشر قواعد فرعه فحلّت محل قواعد
    //  المهام والواجبات وطلبات الدعم، فتعطّلت الثلاثة بالرفض الافتراضي.
    //
    //  أُعيد نسخه هنا حرفيًا حتى لا يؤدي إصلاحُنا إلى كسر ميزتهم بدوره:
    //  مجموعة posts تحوي مستندات حيّة. القواعد ملف عالمي واحد، وأي نشر
    //  يستبدل كل شيء — فالدمج هو الطريقة الوحيدة الصحيحة.
    // ===================================================================
    match /posts/{postId} {

      allow read: if isActiveUser();

      allow create: if isActiveUser()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if isActiveUser()
        && (
          request.auth.uid == resource.data.authorId
          || isActiveAdmin()
        );

      allow delete: if (isActiveUser() && request.auth.uid == resource.data.authorId)
        || isActiveAdmin();

      // -----------------------------------------------------------------
      //  posts/{postId}/comments/{commentId} — التعليقات
      // -----------------------------------------------------------------
      match /comments/{commentId} {
        allow read: if isActiveUser();

        allow create: if isActiveUser()
          && request.resource.data.authorId == request.auth.uid;

        allow update, delete: if (isActiveUser() && request.auth.uid == resource.data.authorId)
          || isActiveAdmin();
      }

      // -----------------------------------------------------------------
      //  posts/{postId}/likes/{userId} — الإعجابات
      // -----------------------------------------------------------------
      match /likes/{userId} {
        allow read: if isActiveUser();
        allow write: if isOwner(userId) && isActiveUser();
      }
    }

    // ===================================================================
    //  reports/{reportId} — البلاغات (اسم Collection مصحَّح: postReports،
    //  متوافق مع PostService._postReports وPostReportModel، لا reports/
    //  reportedBy المنشورين سابقًا بالخطأ عند نسخ قواعد الزميلة حرفيًا).
    // ===================================================================
    match /postReports/{reportId} {
      function d() {
        return request.resource.data;
      }

      // بلاغ لا يُقرأ إلا من الأدمن (طابور المراجعة) — لا يعرف الطالب حتى
      // أن بلاغه وصل، تمامًا مثل supportRequests أعلاه.
      allow read: if isActiveAdmin();

      allow create: if isActiveUser()
        && d().reporterId == request.auth.uid
        && isNonEmptyString(d().postId)
        && isNonEmptyString(d().courseId)
        && isNonEmptyString(d().reason)
        && d().status == 'pending'
        && d().keys().hasAll(
             ['postId', 'courseId', 'reporterId', 'reason', 'status']);

      // الأدمن فقط يحسم البلاغ (pending → resolved)، ولا يعدّل السبب أو
      // مقدّم البلاغ — نفس نمط supportRequests بالضبط.
      allow update: if isActiveAdmin()
        && d().status == 'resolved'
        && d().reporterId == resource.data.reporterId
        && d().postId == resource.data.postId
        && changedKeys().hasOnly(['status']);

      allow delete: if false;
    }

    // ===================================================================
    //  notifications/{notificationId} — إشعارات داخل التطبيق (In-App)
    //
    //  لا Cloud Functions هنا (خطة Spark المجانية): كل مستند تكتبه أداة
    //  العميل نفسها مباشرة بعد نشر منشور بنجاح (NotificationService.
    //  notifyCourseClassmatesOfNewPost)، لا خادم وسيط. القاعدة تسمح لأي
    //  مستخدم فعّال بالكتابة لصالح مستلم آخر تحديدًا لهذا السبب — الناشر
    //  هو من يكتب إشعار زميله، لا زميله لنفسه.
    // ===================================================================
    match /notifications/{notificationId} {
      // المستلم فقط يقرأ إشعاراته — لا أحد يطّلع على إشعارات غيره،
      // ولا حتى الأدمن (لا حاجة إدارية لذلك هنا).
      allow read: if isOwner(resource.data.recipientId);

      allow create: if isActiveUser()
        && isNonEmptyString(request.resource.data.recipientId)
        && isNonEmptyString(request.resource.data.type)
        && request.resource.data.isRead == false;

      // الحقل الوحيد القابل للتغيير بعد الإنشاء هو isRead، وبواسطة
      // المستلم نفسه فقط — تحديد "قرأته" ليس قرارًا يتخذه أحد غيره.
      allow update: if isOwner(resource.data.recipientId)
        && changedKeys().hasOnly(['isRead']);

      allow delete: if false;
    }

    // ===================================================================
    //  Explicit default deny for every unmatched path.
    //  Firestore already denies by default; this documents the intent and
    //  covers any collection created before its rules are written.
    //  (This does not revoke grants from the more specific matches above.)
    // ===================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
